# ===== 必填：Telegram 短信 Bot =====
# Telegram 机器人 Token（向 BotFather 申请）
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 短信网关
ENTJ_API_TOKEN=YOUR_GATEWAY_TOKEN
BASE_URL=https://your-gateway-domain-or-ip/ctrl

# 请求超时秒数
HTTP_TIMEOUT=12

# 允许使用此 Bot 的 Telegram 数字ID（逗号分隔）
ALLOWED_IDS=12345678,87654321

# （可选）如果需要代理访问 Telegram，就取消注释并填写
# HTTPS_PROXY=http://127.0.0.1:7890

# ===== 可选：Bark 兼容推送 relay =====
# 启动方式：docker compose --profile relay up -d --build
# 若 relay 和短信 Bot 使用同一个 Telegram Bot，可以直接复制 TELEGRAM_BOT_TOKEN 的值。
TG_TOKEN=YOUR_BOT_TOKEN_HERE
TG_CHAT=YOUR_TELEGRAM_CHAT_ID
DEVICE_KEYS=KEY1,KEY2,KEY3
TG_TIMEOUT=10
RELAY_WORKERS=2
RELAY_PORT=8787
